# Supabase 대시보드 > Project Settings > API 에서 복사하세요.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# --- 저녁 9시 푸시 알림 (선택). 서버 전용 값은 NEXT_PUBLIC_ 이 붙지 않은 것이며, 절대 공개하지 마세요. ---
# 키 만들기: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Supabase > Project Settings > API 의 service_role(secret) 키. 서버(Vercel)에만 넣으세요.
SUPABASE_SERVICE_ROLE_KEY=
# 임의의 긴 문자열. 크론 호출 확인용 (Vercel 크론이 자동으로 Authorization 헤더에 실어 보냄)
CRON_SECRET=
